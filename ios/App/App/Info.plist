<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>SillyClient</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.9.1</string>
	<key>CFBundleVersion</key>
	<string>16</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- 自定义 URL Scheme 支持 (用于自动化测试与外部唤醒) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sillyclient.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sillyclient</string>
			</array>
		</dict>
	</array>

	<!-- 开启 iOS 原生“文件”App 共享 (iTunes File Sharing & Open in Place) -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- 开启后台轻量静音音频保活，杜绝切后台被系统墓碑挂起 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- 本地酒馆 HTTP 访问权限 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- 本地局域网发现与访问权限声明 (支持局域网其他设备访问酒馆) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>SillyClient 需要访问本地网络以允许本地酒馆服务运行及局域网设备协同访问。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>

	<!-- 麦克风访问权限声明 (支持酒馆语音输入与录音对讲功能) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>SillyClient 需要使用麦克风以支持酒馆语音输入与录音对讲功能。</string>
</dict>
</plist>
